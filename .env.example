# Copy to .env and fill in. Only the VITE_SUPABASE_* values are required.

# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Error monitoring (optional) — leave blank to disable Sentry.
VITE_SENTRY_DSN=

# Product analytics (optional) — leave blank to disable PostHog.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# NOTE: ANTHROPIC_API_KEY is NOT set here. It is a server-side Supabase Edge
# Function secret (set it in the Supabase dashboard), never a frontend var.
